{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"installCommand": "npm install && npm --prefix client install",
	"buildCommand": "npm run build && npm --prefix client run build",
	"outputDirectory": "client/dist",
	"functions": {
		"api/index.js": { "maxDuration": 60 }
	},
	"rewrites": [
		{ "source": "/api/:path*", "destination": "/api" },
		{ "source": "/health", "destination": "/api" },
		{ "source": "/((?!api/|health$).*)", "destination": "/index.html" }
	]
}

{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "PY=python3; command -v python3 >/dev/null 2>&1 || PY=python; \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post_tool_use_enum_check.py\"",
						"timeout": 15
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "PY=python3; command -v python3 >/dev/null 2>&1 || PY=python; \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre_tool_use_block_no_verify.py\"",
						"timeout": 10
					}
				]
			}
		]
	}
}